---
---

<section class="map-section">
  <div class="map-section__header">
    <span class="map-section__tag">Где нас найти</span>
    <h2 class="map-section__title">Наш офис</h2>
    <p class="map-section__address">
      <span class="map-section__address-icon">📍</span>
      Санкт-Петербург, просп. Просвещения, 43
    </p>
  </div>
  <div class="map-section__map" id="map-content"></div>
</section>

<script>
  const script = document.createElement('script');
  script.type = 'text/javascript';
  script.charset = 'utf-8';
  script.async = true;
  script.src =
    'https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A1cd84b0032042b859d1605599ba3e6f3afdbe66b57ebf6e354a16a84f7ba484e&width=100%25&height=400&lang=ru_RU&scroll=true';
  document.getElementById('map-content')!.appendChild(script);
</script>

<style>
  .map-section {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin: 48px 0;
  }

  .map-section__header {
    padding: 40px 48px 32px;
    text-align: center;
  }

  .map-section__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(78, 203, 163, 0.12);
    border: 1px solid rgba(78, 203, 163, 0.3);
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .map-section__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .map-section__address {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .map-section__address-icon {
    font-size: 1rem;
  }

  .map-section__map {
    width: 100%;
    height: 400px;
  }

  @media (max-width: 768px) {
    .map-section {
      border-radius: var(--radius-lg);
    }

    .map-section__header {
      padding: 28px 24px 20px;
    }

    .map-section__map {
      height: 300px;
    }
  }

  @media (max-width: 500px) {
    .map-section {
      border-radius: var(--radius-md);
      margin: 24px 0;
    }

    .map-section__map {
      height: 240px;
    }
  }
</style>