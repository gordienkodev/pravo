---
import ConsultationButton from './ConsultationButton.astro';
import ContactForm from './ContactForm.astro';
---

<header>
  <nav class="navbar">
    <div class="name-container">
      <div>Рыжков</div>
      <div>Сергей</div>
      <div>Анатольевич</div>
    </div>
    <ConsultationButton nameButton="Бесплатная консультация" />
    <ContactForm />
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1440px;
    margin: 0 auto;
    padding: 15px;
  }

  .navbar a {
    margin: 0 10px;
  }

  .name-container {
    color: #000000;
    font-size: 1.5em;
    text-transform: uppercase;
    font-weight: bold;
    font-family: Arial, Helvetica, sans-serif;
  }

  .name-container div {
    margin-bottom: 5px;
  }

  @media (max-width: 1000px) {
    .navbar {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .navbar a {
      margin: 10px 0;
    }

    .name-container {
      display: flex;
      flex-direction: row;
      gap: 10px;
    }
  }

  @media (max-width: 500px) {
    .navbar {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }

    .navbar a {
      margin: 5px 0;
    }

    .name-container {
      display: flex;
      flex-direction: row;
      gap: 5px;
      font-size: 1em;
    }
  }
</style>
