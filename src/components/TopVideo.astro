---
const videos = ['video1.mp4', 'video2.mp4'];
const videoSrc = videos[Math.floor(Math.random() * videos.length)];
---

<div class="top__content">
  <video class="top__content-video" loop muted autoplay playsinline>
    <source src={`https://zhilischnoe-pravo.ru/video/${videoSrc}`} type="video/mp4" />
  </video>
  <div class="top__overlay"></div>
  <div class="top__content-item">
    <h1 class="top__title">Юрист Рыжков Сергей Анатольевич</h1>
    <div class="top__text">
      Если у меня получится решить Вашу проблему по телефону, я не возьму с
      Вас денег. Консультации по телефону я провожу бесплатно.
    </div>
  </div>
</div>

<style>
  .top__content {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    border-radius: 40px;
    padding: 80px;
    margin-bottom: 100px;
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .top__content-video {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .top__overlay {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(139, 236, 209, 0.9) 10%,
      rgba(139, 236, 209, 0.2) 60%
    );
  }

  .top__content-item {
    max-width: 430px;
    text-align: left;
    position: relative;
    z-index: 2;
  }

  .top__title {
    font-weight: 600;
    padding-bottom: 40px;
  }

  .top__text {
    font-size: 2em;
    color: #23574d;
    font-family: Arial, Helvetica, sans-serif;
  }

  @media (max-width: 500px) {
    .top__text {
      display: none;
    }

    .top__content {
      padding: 40px 24px;
      margin-bottom: 32px;
      border-radius: 20px;
      min-height: 280px;
    }
  }
</style>