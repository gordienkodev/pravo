<div class="contact-form-container">
  <div class="phone-block">
    <a class="phone-link" href="tel:+79315909970">
      +7 (931) 590 99 70
    </a>
  </div>
  <div class="order-block">
    <span class="phone-icon">&#9742;</span>
    <a class="order-link" href="#" id="order-call-link">
      Заказать бесплатный звонок
    </a>
  </div>
  <div class="address-block">Санкт-Петербург, Просвещения пр. 43</div>
</div>

<script>
  document.getElementById('order-call-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    (window as any).openPopupForm?.();
  });
</script>

<style>
  .contact-form-container {
    font-family: Arial, sans-serif;
  }

  .phone-icon {
    color: #0f6d52;
    font-size: 1.5em;
    margin-right: 5px;
  }

  .phone-link {
    font-size: 2em;
    color: black;
    text-decoration: none;
    border-radius: 10px;
    display: inline-block;
  }

  .phone-link:hover {
    color: #0f6d52;
  }

  .order-block {
    margin: 5px 10px;
  }

  .order-block span {
    color: #0f6d52;
    font-size: 1.5em;
    margin-right: 5px;
  }

  .order-link {
    color: #0f6d52;
    font-size: 1.2em;
    text-decoration: none;
    border-bottom: 1px dotted;
  }

  .order-link:hover {
    font-size: 1.2em;
    color: #1db187;
  }

  .address-block {
    margin: 10px;
    color: black;
  }

  @media (max-width: 500px) {
    .phone-link {
      font-size: 1.2em;
    }
  }
</style>
