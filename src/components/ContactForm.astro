---

<div class="contacts">
  <a class="contacts__phone" href="tel:+79315909970">
    +7 (931) 590-99-70
  </a>
  <a class="contacts__callback" href="#" id="order-call-link">
    <span class="contacts__callback-icon">📞</span>
    Заказать звонок бесплатно
  </a>
  <div class="contacts__address">
    <span class="contacts__address-icon">📍</span>
    Санкт-Петербург, просп. Просвещения, 43
  </div>
</div>

<script>
  document.getElementById('order-call-link')?.addEventListener('click', (e) => {
    e.preventDefault();
    (window as any).openPopupForm?.();
  });
</script>

<style>
  .contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--font-body);
  }

  .contacts__phone {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color var(--transition);
    line-height: 1.2;
  }

  .contacts__phone:hover {
    color: var(--color-accent);
  }

  .contacts__callback {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary-light);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px dashed rgba(35, 87, 77, 0.4);
    padding-bottom: 1px;
    transition: color var(--transition), border-color var(--transition);
  }

  .contacts__callback:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .contacts__callback-icon {
    font-size: 0.8rem;
  }

  .contacts__address {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .contacts__address-icon {
    font-size: 0.75rem;
  }

  @media (max-width: 1000px) {
    .contacts {
      align-items: center;
    }
  }

  @media (max-width: 500px) {
    .contacts__phone {
      font-size: 1.1rem;
    }
  }
</style>