<footer class="footer">
  <div class="footer__top-border"></div>
  <div class="footer__inner">
    <div class="footer__brand">
      <div class="footer__brand-text">
        <span class="footer__name">Рыжков Сергей Анатольевич</span>
        <span class="footer__specialty">Юрист по жилищному праву</span>
      </div>
    </div>

    <div class="footer__contacts">
      <a class="footer__phone" href="tel:+79315909970">
        <span class="footer__phone-icon">📞</span>
        +7 (931) 590-99-70
      </a>
      <address class="footer__address">
        Санкт-Петербург, просп. Просвещения, 43
      </address>
    </div>

    <div class="footer__legal">
      <button class="footer__privacy-btn" id="privacy-policy-btn">
        Политика конфиденциальности
      </button>
      <span class="footer__copy">© {new Date().getFullYear()} Все права защищены</span>
    </div>
  </div>
</footer>

<!-- Модалка политики конфиденциальности -->
<div class="modal-overlay" id="privacy-modal" style="display:none;">
  <div class="modal-content" id="privacy-modal-inner">
    <div class="modal-header">
      <h3 class="modal-title">Политика конфиденциальности</h3>
      <button class="modal-close" id="privacy-modal-close" aria-label="Закрыть">&times;</button>
    </div>
    <div class="modal-body">
      <p>
        Любая информация, представленная на данном сайте, носит исключительно
        информационный характер и ни при каких условиях не является публичной
        офертой, определяемой положениями статьи 437 ГК РФ. Отправляя сведения через
        любую электронную форму на этом сайте, вы даёте согласие на обработку ваших
        персональных данных.
      </p>
      <h4>Соглашение на обработку персональных данных</h4>
      <p>
        Настоящим в соответствии с Федеральным законом № 152-ФЗ «О персональных
        данных» от 27.07.2006 года Вы подтверждаете свое согласие на обработку
        сайтом zhilischnoe-pravo.ru персональных данных: сбор, систематизацию,
        накопление, хранение, уточнение (обновление, изменение), использование,
        передачу исключительно в целях продажи программного обеспечения на Ваше имя,
        как это описано ниже, блокирование, обезличивание, уничтожение.
      </p>
      <p>
        Сайт zhilischnoe-pravo.ru гарантирует конфиденциальность получаемой информации.
        Обработка персональных данных осуществляется в целях эффективного исполнения
        заказов, договоров и иных обязательств, принятых сайтом zhilischnoe-pravo.ru
        в качестве обязательных к исполнению.
      </p>
      <p>
        Настоящее согласие действует в течение всего периода хранения персональных
        данных, если иное не предусмотрено законодательством Российской Федерации.
        Вы можете в любой момент отозвать согласие, направив уведомление на адрес:
        admin@zhilischnoe-pravo.ru с пометкой «Отзыв согласия на обработку
        персональных данных».
      </p>
    </div>
    <div class="modal-footer">
      <button class="modal-ok" id="privacy-modal-ok">Принять</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('privacy-modal') as HTMLElement;
  const modalInner = document.getElementById('privacy-modal-inner') as HTMLElement;
  const openBtn = document.getElementById('privacy-policy-btn') as HTMLElement;
  const closeBtn = document.getElementById('privacy-modal-close') as HTMLElement;
  const okBtn = document.getElementById('privacy-modal-ok') as HTMLElement;

  function openModal() {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  okBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (!modalInner.contains(e.target as Node)) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(255,255,255,0.75);
    margin-top: 48px;
  }

  .footer__top-border {
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-primary-light) 50%, transparent 100%);
  }

  .footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer__initials {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-accent) 100%);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer__brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .footer__specialty {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer__contacts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .footer__phone {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-white);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer__phone:hover {
    color: var(--color-accent-light);
  }

  .footer__phone-icon {
    font-size: 1rem;
  }

  .footer__address {
    font-style: normal;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.5);
    text-align: center;
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .footer__privacy-btn {
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.45);
    font-size: 0.78rem;
    font-family: var(--font-body);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition);
    padding: 0;
  }

  .footer__privacy-btn:hover {
    color: var(--color-accent-light);
  }

  .footer__copy {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
  }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2000;
    padding: 20px;
  }

  .modal-content {
    background: var(--color-white);
    border-radius: var(--radius-md);
    width: 100%;
    max-width: 720px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px 16px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .modal-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-primary);
    margin: 0;
  }

  .modal-close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--color-text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: background var(--transition), color var(--transition);
  }

  .modal-close:hover {
    background: rgba(0,0,0,0.06);
    color: var(--color-text);
  }

  .modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .modal-body p {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.65;
  }

  .modal-body h4 {
    font-family: var(--font-heading);
    color: var(--color-primary);
    font-size: 1rem;
    margin-top: 4px;
  }

  .modal-footer {
    padding: 16px 24px;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    justify-content: flex-end;
  }

  .modal-ok {
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    padding: 10px 28px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: background var(--transition);
  }

  .modal-ok:hover {
    background: var(--color-primary-light);
  }

  @media (max-width: 768px) {
    .footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 24px 20px;
      gap: 20px;
    }

    .footer__legal {
      align-items: center;
    }
  }
</style>