<script>
  const modal = document.getElementById('privacy-modal') as HTMLElement;
  const modalInner = document.getElementById('privacy-modal-inner') as HTMLElement;
  const openBtn = document.getElementById('privacy-policy-btn') as HTMLElement;
  const closeBtn = document.getElementById('privacy-modal-close') as HTMLElement;
  const okBtn = document.getElementById('privacy-modal-ok') as HTMLElement;

  function openModal() {
    modal.style.display = 'flex';
  }

  function closeModal() {
    modal.style.display = 'none';
  }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  okBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (!modalInner.contains(e.target as Node)) {
      closeModal();
    }
  });
</script>

