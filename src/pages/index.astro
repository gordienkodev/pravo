---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopVideo from '../components/TopVideo.astro';
import Services from '../components/Services.astro';
import Steps from '../components/Steps.astro';
import Map from '../components/Map.astro';
import ConsultationButton from '../components/ConsultationButton.astro';
import PopupForm from '../components/PopupForm.astro';
---

<Layout>
  <div class="page-wrapper">
    <Header />
    <main class="main-content">
      <TopVideo />
      <Services />
      <div class="cta-section">
        <ConsultationButton nameButton="Обратиться за консультацией" />
      </div>
      <Steps />
      <div class="cta-section">
        <ConsultationButton nameButton="Бесплатная консультация" />
      </div>
      <Map />
    </main>
    <Footer />
  </div>

  <PopupForm />
</Layout>

<style>
  .page-wrapper {
    width: 100%;
  }

  .main-content {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 24px 0;
    box-sizing: border-box;
  }

  .cta-section {
    display: flex;
    justify-content: center;
    padding: 16px 0 32px;
  }

  @media (max-width: 500px) {
    .main-content {
      padding: 16px 12px 0;
    }
  }
</style>